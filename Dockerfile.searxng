ARG SEARXNG_VERSION=2026.8.28-a30b2d474
FROM ghcr.io/searxng/searxng:${SEARXNG_VERSION}

# Layer in the BM25 reranker plugin (post_search reranking, title-weighted).
# https://github.com/Oaklight/searxng-bm25-reranker
# This venv ships without pip (slim runtime image, Void Linux base) - bootstrap
# it, install, then strip it back out so the final image stays as lean as
# upstream intended.
RUN /usr/local/searxng/.venv/bin/python -m ensurepip --upgrade \
 && /usr/local/searxng/.venv/bin/python -m pip install --no-cache-dir searxng-bm25-reranker \
 && /usr/local/searxng/.venv/bin/python -m pip uninstall -y pip setuptools wheel
