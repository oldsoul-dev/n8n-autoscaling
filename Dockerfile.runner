# Multi-stage build to add dependencies to n8n runners
# This works around the issue where n8nio/runners v2.1.0+ removed apk

ARG N8N_VERSION=2.38.7

# Stage 1: Build dependencies in Alpine (must match n8nio/runners base version)
FROM alpine:3.23 AS builder

RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont \
    ffmpeg \
    git \
    openssh-client \
    graphicsmagick \
    imagemagick

# Stage 1b: Build a Corepack install to copy into the final image.
# n8nio/runners removed apk (see top-of-file note), and Node 25+ no longer
# bundles Corepack by default — so the final stage has neither a package
# manager nor Corepack to install one with. Build it here, where npm exists,
# and COPY the result in below, the same way chromium/ffmpeg/etc. are copied
# from the `builder` stage.
#
# Pinned to 0.35.0 deliberately, not "latest": that's the exact version that
# used to ship bundled with n8nio/runners:2.36.8 (confirmed by inspecting that
# image directly). corepack@latest resolved to 0.36.0 during testing and
# reintroduced ERR_PNPM_UNEXPECTED_STORE -- the very bug the pnpm@10 pin below
# exists to avoid -- so a newer Corepack is not a safe drop-in here. Bump this
# pin deliberately (and re-test the `pnpm add` step below) if it ever needs to
# move.
FROM node:22-alpine AS corepack-builder
RUN npm install -g corepack@0.35.0

# Stage 2: Copy to the task-runner release matching the n8n server
FROM n8nio/runners:${N8N_VERSION}

USER root

# Copy all libraries from builder (chromium has many dependencies)
COPY --from=builder /usr/lib/ /usr/lib/
COPY --from=builder /usr/share/fonts/ /usr/share/fonts/

# Copy binaries from builder
COPY --from=builder /usr/bin/chromium-browser /usr/bin/chromium-browser
COPY --from=builder /usr/bin/ffmpeg /usr/bin/ffmpeg
COPY --from=builder /usr/bin/ffprobe /usr/bin/ffprobe
COPY --from=builder /usr/bin/git /usr/bin/git
COPY --from=builder /usr/bin/gm /usr/bin/gm
# ImageMagick binaries
COPY --from=builder /usr/bin/magick /usr/bin/magick
COPY --from=builder /usr/bin/convert /usr/bin/convert
COPY --from=builder /usr/bin/identify /usr/bin/identify
COPY --from=builder /usr/bin/mogrify /usr/bin/mogrify
COPY --from=builder /usr/bin/composite /usr/bin/composite

# Create symlink for chromium-browser wrapper script
RUN ln -sf /usr/lib/chromium/chromium /usr/bin/chromium

# Install npm packages in the task runner's node_modules directory
WORKDIR /opt/runners/task-runner-javascript
# Pin pnpm to match whatever this base image's node_modules was already
# linked with, or `corepack pnpm add` fails with ERR_PNPM_UNEXPECTED_STORE
# (see issue #26). This pin is NOT stable across n8n versions -- upstream's
# own n8nio/runners image has changed its bundled pnpm major version at
# least once already (v10 as of 2.36.8, v11 as of 2.38.6), and there's no
# packageManager field in the runner's package.json to auto-detect it from.
#
# On every version bump, re-check what's actually linked before assuming
# this pin still matches:
#   docker run --rm -u root --entrypoint sh n8nio/runners:<version> -c \
#     "cat /opt/runners/task-runner-javascript/node_modules/.modules.yaml" \
#     | grep packageManager
# Confirmed via the command above against n8nio/runners:2.38.6 -- linked
# with pnpm@11.22.0 (was pnpm@10.x for 2.36.8).
#
# Corepack is no longer bundled with the Node base image as of Node 25+, and
# this stage has no npm/apk to install it with directly (see corepack-builder
# stage above). Copy the Corepack package built there into the exact path
# the two RUN lines below already expect, so those upstream commands work
# unmodified.
COPY --from=corepack-builder /usr/local/lib/node_modules/corepack /usr/local/lib/node_modules/corepack
COPY --from=corepack-builder /usr/local/bin/corepack /usr/local/bin/corepack
RUN /usr/local/bin/node /usr/local/lib/node_modules/corepack/dist/corepack.js prepare pnpm@11.22.0 --activate
RUN /usr/local/bin/node /usr/local/lib/node_modules/corepack/dist/corepack.js pnpm add \
    ajv \
    ajv-formats \
    puppeteer-core@22.15.0 \
    puppeteer-extra \
    puppeteer-extra-plugin-stealth \
    playwright-core \
    playwright-extra

# Install Python packages in the task runner's venv
RUN /usr/local/bin/uv pip install --python /opt/runners/task-runner-python/.venv/bin/python --no-cache \
    requests \
    pillow \
    pandas \
    numpy

# Copy custom task runner config that:
# - Removes --disable-proto=delete flag (allows puppeteer/playwright to work)
# - Allowlists puppeteer-core, playwright-core and other packages
# - Sets PUPPETEER_EXECUTABLE_PATH and PLAYWRIGHT env vars in env-overrides
COPY n8n-task-runners.json /etc/n8n-task-runners.json
RUN chmod 644 /etc/n8n-task-runners.json

# Set Puppeteer to use system Chromium
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Set Playwright to use system Chromium (skip browser download)
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

USER runner
WORKDIR /home/runner
